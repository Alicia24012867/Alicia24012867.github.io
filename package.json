{
  "name": "alicia-sky-homepage",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build && node scripts/verify-build.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "check": "npm test && npm run build",
    "format": "prettier --write src scripts tests *.ts *.json *.html blog/index.html notes/index.html",
    "format:check": "prettier --check src scripts tests *.ts *.json *.html blog/index.html notes/index.html",
    "bundle:report": "node scripts/measure-bundle.mjs"
  },
  "dependencies": {
    "entities": "8.1.0",
    "highlight.js": "11.12.0",
    "katex": "0.16.27",
    "marked": "18.0.13",
    "mermaid": "12.0.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sanitize-html": "2.17.7",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "8.3.0"
  },
  "packageManager": "npm@11.9.0"
}
