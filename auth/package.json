{
  "name": "nymphilia-auth",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node src/main.ts",
    "dev": "node --watch src/main.ts",
    "assets": "node scripts/assets.ts",
    "contract-issuer": "node --disable-warning=ExperimentalWarning scripts/contract-issuer.ts",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "node --test --test-concurrency=1 'test/*.test.ts'",
    "check": "npm run format:check && npm run typecheck && node scripts/assets.ts --check && npm test",
    "format": "prettier --write src test scripts public/auth.js public/style.css",
    "format:check": "prettier --check src test scripts public/auth.js public/style.css"
  },
  "dependencies": {
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.3",
    "oidc-provider": "9.13.3"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/oidc-provider": "9.13.1",
    "openid-client": "6.8.9",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  }
}
