# nymphilia.com: the built site, unpacked by /srv/site/bin/receive. The Caddyfile in
# /srv/proxy/conf imports this file beside the git, cloud and vpn sites.
(secure_headers) {
	header {
		Strict-Transport-Security "max-age=31556952"
		-Server
	}
}

# Pages, pictures and feeds may be read by any site; the API's answers are for this one alone.
(site_headers) {
	import secure_headers
	header Access-Control-Allow-Origin *
}

nymphilia.com {
	encode zstd gzip

	# The blog API, blog-api in /srv/site/compose.yml, answers everything under /api/. Its
	# answers say themselves how long they keep, and are for this site's own pages.
	handle /api/* {
		import secure_headers
		reverse_proxy blog-api:8080
	}

	handle {
		root * /srv/site/public/current
		import site_headers
		# Built files carry a hash of their contents in their names, so they never change.
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		# Pages, the service worker, feeds and key rings change in place: browsers always ask.
		@fresh path / */ *.html /sw.js /manifest.webmanifest /rss.xml /atom.xml /sitemap.xml /robots.txt /locked/*
		header @fresh Cache-Control "no-cache"
		# Fonts and images keep the ten minutes GitHub Pages gave them.
		header ?Cache-Control "max-age=600"
		file_server
	}

	# Unknown addresses show the site's own 404 page and keep the 404 status.
	handle_errors 404 {
		root * /srv/site/public/current
		encode zstd gzip
		import site_headers
		header Cache-Control "no-cache"
		rewrite * /404.html
		file_server
	}

	# While the blog API is away, pages hear it in the API's own words.
	handle_errors 502 503 504 {
		@api path /api/*
		handle @api {
			import secure_headers
			header Content-Type application/json
			header Cache-Control no-store
			respond `{"error":"server_error","message":"The blog API is not running right now."}` 503
		}
	}
}

# Straight to the site, in one step from http:// as well.
www.nymphilia.com, http://www.nymphilia.com {
	import site_headers
	redir https://nymphilia.com{uri} permanent
}
